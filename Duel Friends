<script>
(function(){
  "use strict";

  /* ---------- helpers ---------- */
  const $ = (id)=> document.getElementById(id);
  function pad2(n){ return n<10 ? "0"+n : ""+n; }
  function dayKey(d){ return d.getFullYear()+"-"+pad2(d.getMonth()+1)+"-"+pad2(d.getDate()); }
  function todayKey(){ return dayKey(new Date()); }
  function hashStr(s){ let h=1779033703 ^ s.length; for(let i=0;i<s.length;i++){ h=Math.imul(h ^ s.charCodeAt(i),3432918353); h=(h<<13)|(h>>>19); } return function(){ h=Math.imul(h ^ (h>>>16),2246822507); h=Math.imul(h ^ (h>>>13),3266489909); h^=h>>>16; return h>>>0; }; }
  function mulberry32(a){ return function(){ a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a ^ a>>>15, 1|a); t=t+Math.imul(t ^ t>>>7, 61|t) ^ t; return ((t ^ t>>>14)>>>0)/4294967296; }; }
  function rngOf(seed){ const h=hashStr(seed); return mulberry32(h()); }
  function pick(rng,a){ return a[Math.floor(rng()*a.length)]; }
  function pickN(rng,a,n){ const c=a.slice(), out=[]; while(out.length<n && c.length) out.push(c.splice(Math.floor(rng()*c.length),1)[0]); return out; }
  function shuffle(rng,a){ const x=a.slice(); for(let i=x.length-1;i>0;i--){ const j=Math.floor(rng()*(i+1)); [x[i],x[j]]=[x[j],x[i]]; } return x; }
  function rInt(rng,min,max){ return Math.floor(rng()*(max-min+1))+min; }
  function clamp(v,a,b){ return Math.max(a,Math.min(b,v)); }
  const now = ()=> performance.now();

  let LS_OK = true;
  try{ const k="__t"; localStorage.setItem(k,"1"); localStorage.removeItem(k); }catch(e){ LS_OK=false; }
  function load(key,fb){ if(!LS_OK) return fb; try{ const v=localStorage.getItem(key); return v==null?fb:JSON.parse(v); }catch(e){ return fb; } }
  function store(key,val){ if(!LS_OK) return; try{ localStorage.setItem(key,JSON.stringify(val)); }catch(e){} }

  /* ---------- content ---------- */
  const NAMES=["Lina","Finn","Mara","Kaya","Noel","Ida","Theo","Leni","Mio","Nora","Elias","Frieda","Anton","Sina","Jonas","Emil","Paula","Luis","Mila","Ben","Ronja","Piet","Zoe","Karl","Vera","Timo","Alva","Kian"];
  const WORDS={
    S:["Sonne","Stern","Stuhl","Straße","Sand","Segel","Katze","Baum","Fisch","Mond","Spiegel","Berg","Wolke","Suppe"],
    B:["Blume","Baum","Ball","Berg","Buch","Brot","Katze","Sonne","Boot","Brücke","Banane","Fisch","Biene","Wald"],
    F:["Fisch","Fenster","Feuer","Flasche","Freund","Fahrrad","Katze","Sonne","Frosch","Farbe","Fuchs","Baum","Feder","Wald"],
    M:["Mond","Maus","Musik","Meer","Motor","Melone","Katze","Sonne","Milch","Mütze","Berg","Mauer","Baum","Möwe"],
    W:["Wolke","Wald","Wasser","Wind","Wagen","Wiese","Katze","Sonne","Winter","Würfel","Berg","Wurm","Baum","Weg"]
  };
  const COLORS=[
    {n:"Rot",h:"#FF4D4D"},{n:"Blau",h:"#3B82F6"},{n:"Grün",h:"#22C55E"},
    {n:"Gelb",h:"#FACC15"},{n:"Pink",h:"#FF2E9A"},{n:"Orange",h:"#FB923C"}
  ];
  const TILE_HEX=["#FF4D4D","#3B82F6","#22C55E","#FACC15","#FF2E9A","#FB923C","#2EE6FF","#C8FF2E","#A78BFA"];
  const FRIENDS=[
    {id:"f1",name:"Mara",ava:"🦊",skill:.78},
    {id:"f2",name:"Finn",ava:"🐼",skill:.62},
    {id:"f3",name:"Kaya",ava:"🐸",skill:.9},
    {id:"f4",name:"Theo",ava:"🦁",skill:.55},
    {id:"f5",name:"Ida",ava:"🐧",skill:.7}
  ];
  const SHOP={
    avatar:[
      {id:"av_fox",name:"Fuchs",pv:"🦊",price:120},{id:"av_panda",name:"Panda",pv:"🐼",price:120},
      {id:"av_bot",name:"Roboter",pv:"🤖",price:200},{id:"av_ninja",name:"Ninja",pv:"🥷",price:250},
      {id:"av_alien",name:"Alien",pv:"👾",price:280},{id:"av_uni",name:"Einhorn",pv:"🦄",price:320}
    ],
    background:[
      {id:"bg_neon",name:"Neon",pv:"🟩",price:150},{id:"bg_night",name:"Midnight",pv:"🟪",price:180},
      {id:"bg_sunset",name:"Sunset",pv:"🟧",price:180},{id:"bg_gold",name:"Gold",pv:"🟨",price:300}
    ],
    title:[
      {id:"tt_fast",name:"Blitzschnell",pv:"⚡",price:100},{id:"tt_brain",name:"Big Brain",pv:"🧠",price:100},
      {id:"tt_night",name:"Nachteule",pv:"🌙",price:120},{id:"tt_goat",name:"GOAT",pv:"🐐",price:450}
    ],
    effect:[
      {id:"ef_spark",name:"Funken",pv:"✨",price:220},{id:"ef_fire",name:"Flammen",pv:"🔥",price:260},
      {id:"ef_conf",name:"Konfetti",pv:"🎉",price:200},{id:"ef_ice",name:"Frost",pv:"❄️",price:240}
    ]
  };
  const BADGES=[
    {id:"streak7",ic:"🔥",name:"7 Tage",desc:"7 Tage in Folge gespielt."},
    {id:"streak30",ic:"💎",name:"30 Tage",desc:"30 Tage in Folge gespielt."},
    {id:"firstwin",ic:"🥇",name:"Erster Sieg",desc:"Dein erstes Duell gewonnen."},
    {id:"tenwins",ic:"🏆",name:"10 Siege",desc:"Zehn Duelle gewonnen."},
    {id:"perfect",ic:"🎯",name:"Perfekt",desc:"Alle 5 Challenges an einem Tag richtig."}
  ];
  const KIND_LABEL={ memory:"Memory", reaction:"Reaction", math:"Math", color:"Color", words:"Words", observation:"Observation" };

  /* ---------- state ---------- */
  const FRESH = {
    profile:{ username:"Player"+Math.floor(Math.random()*900+100), level:1, xp:0, coins:80, wins:0, losses:0, longestStreak:0,
      equipped:{ avatar:"🙂", background:null, title:null, effect:null } },
    inventory:[], streak:{ count:0, last:null }, lastReward:null, badges:[], duels:[],
    modeBest:{ sudden:0, endless:0 }, history:{}
  };
  let S = load("dd_v2", null) || JSON.parse(JSON.stringify(FRESH));
  for(const k in FRESH){ if(!(k in S)) S[k] = JSON.parse(JSON.stringify(FRESH[k])); }
  function save(){ store("dd_v2", S); }

  /* ---------- challenges ---------- */
  const TYPES=["memory","reaction","math","color","words","observation"];

  function dailySet(key){
    const rng = rngOf("d:"+key);
    return shuffle(rng, TYPES).slice(0,5).map((t,i)=> build(t, rngOf("d:"+key+":"+i+":"+t)));
  }
  function build(type, rng){
    if(type==="memory"){
      const len = rInt(rng,3,5); let n="";
      for(let i=0;i<len;i++) n += rInt(rng,0,9);
      return { type, task:"Merk dir die Zahl.", limit:9000, d:{ n, flash:1100+len*160 } };
    }
    if(type==="reaction"){
      return { type, task:"Tippe, sobald es grün wird.", limit:6000, d:{ delay:rInt(rng,1200,3200) } };
    }
    if(type==="math"){
      const a=rInt(rng,2,20), b=rInt(rng,2,20), op=pick(rng,["+","−","×"]);
      const ans = op==="+"? a+b : op==="−"? a-b : a*b;
      const wrong=new Set();
      while(wrong.size<3){ const w=ans + rInt(rng,1,9)*(rng()<.5?-1:1); if(w!==ans) wrong.add(w); }
      return { type, task:"Wie viel ist das?", limit:8000, d:{ q:a+" "+op+" "+b, ans, opts:shuffle(rng,[ans,...wrong]) } };
    }
    if(type==="color"){
      const word = pick(rng, COLORS);
      let ink = pick(rng, COLORS);
      if(ink.h===word.h) ink = COLORS[(COLORS.indexOf(ink)+1)%COLORS.length];
      const set=new Set([ink]); while(set.size<4) set.add(pick(rng,COLORS));
      return { type, task:"Tippe die Farbe, nicht das Wort.", limit:8000, d:{ word:word.n, ink, opts:shuffle(rng,Array.from(set)) } };
    }
    if(type==="words"){
      const letter = pick(rng, Object.keys(WORDS));
      const bank = WORDS[letter];
      const good = pickN(rng, bank.filter(w=>w[0]===letter), 5);
      const bad  = pickN(rng, bank.filter(w=>w[0]!==letter), 3);
      return { type, task:"Finde alle Wörter mit „"+letter+"“.", limit:10000, d:{ letter, chips:shuffle(rng,[...good,...bad]), good, need:good.length } };
    }
    const tiles = pickN(rng, TILE_HEX, 9);
    const idx = rInt(rng,0,8);
    const after = tiles.slice();
    after[idx] = pick(rng, TILE_HEX.filter(c=>c!==tiles[idx]));
    return { type:"observation", task:"Was hat sich verändert?", limit:8000, d:{ before:tiles, after, idx, flash:1800 } };
  }
  function scoreOf(ok, ms, limit){
    if(!ok) return 0;
    return Math.round(200 + 800*clamp(1-(ms/limit),0,1));
  }
  function botScore(id, key, i, skill){
    const rng = rngOf("b:"+id+":"+key+":"+i);
    if(rng() > (.55 + skill*.4)) return 0;
    return Math.round(clamp(250 + rng()*650*skill + rng()*80, 80, 1000));
  }

  /* ---------- navigation ---------- */
  const SCREENS=["home","duels","modes","board","profile","shop","play","results"];
  function show(name){
    SCREENS.forEach(s=>{ const el=$("screen-"+s); if(el) el.hidden = (s!==name); });
    document.querySelectorAll(".navbtn").forEach(b=> b.classList.toggle("active", b.dataset.screen===name));
    const playing = (name==="play");
    $("content").classList.toggle("stage-mode", playing);
    document.querySelector(".nav").hidden = playing;
    document.querySelector(".topbar").hidden = playing;
    $("content").scrollTop = 0;
  }
  document.querySelectorAll(".navbtn").forEach(b=>{
    b.addEventListener("click", ()=>{
      const t=b.dataset.screen; show(t);
      if(t==="duels") renderDuels();
      if(t==="modes") renderModes();
      if(t==="board") renderBoard();
      if(t==="profile") renderProfile();
      if(t==="home") renderHome();
    });
  });
  $("coinPill").addEventListener("click", ()=>{ show("shop"); renderShop(); });
  $("btnShop").addEventListener("click", ()=>{ show("shop"); renderShop(); });

  let toastT=null;
  function toast(msg, miss){
    const el=$("toast");
    el.textContent=msg;
    el.classList.toggle("miss", !!miss);
    el.classList.add("show");
    clearTimeout(toastT);
    toastT=setTimeout(()=> el.classList.remove("show"), 1000);
  }

  /* ---------- header + home ---------- */
  function renderHeader(){
    $("hdrStreak").textContent = S.streak.count;
    $("hdrCoins").textContent = S.profile.coins;
  }
  function today(){
    const k=todayKey();
    if(!S.history[k]) S.history[k]={ done:false, score:0, slots:0 };
    return S.history[k];
  }
  function renderHome(){
    const d=new Date();
    const months=["Jan","Feb","Mär","Apr","Mai","Jun","Jul","Aug","Sep","Okt","Nov","Dez"];
    $("dateTag").textContent = d.getDate()+". "+months[d.getMonth()];

    const t=today();
    const slots=$("slots"); slots.innerHTML="";
    for(let i=0;i<5;i++){
      const el=document.createElement("div");
      el.className="slot"+(i<t.slots?" done":"");
      el.innerHTML = i<t.slots ? (i+1) : (i+1);
      slots.appendChild(el);
    }
    if(t.done){
      $("heroTitle").innerHTML="Heute<br>geschafft";
      $("heroSub").textContent = t.score.toLocaleString("de-DE")+" Punkte geholt. Morgen gibt es neue Challenges.";
      $("btnStart").textContent="Ergebnis ansehen";
    } else if(t.slots>0){
      $("heroTitle").innerHTML="Noch "+(5-t.slots)+"<br>übrig";
      $("heroSub").textContent="Du bist mittendrin. Weiter geht's.";
      $("btnStart").textContent="Weiterspielen";
    } else {
      $("heroTitle").innerHTML="5 neue<br>Challenges";
      $("heroSub").textContent="Alle spielen heute dieselben Aufgaben. Schnell sein bringt mehr Punkte.";
      $("btnStart").textContent="Duell starten";
    }

    $("streakNum").textContent = S.streak.count;
    $("streakHint").textContent = S.streak.count===0 ? "Heute spielen startet deine Serie"
      : S.streak.count<7 ? "Noch "+(7-S.streak.count)+" Tage bis 🔥 7 Tage"
      : S.streak.count<30 ? "Noch "+(30-S.streak.count)+" Tage bis 💎 30 Tage"
      : "Alle Serien-Abzeichen geholt";

    const wk=$("week"); wk.innerHTML="";
    const labels=["M","D","M","D","F","S","S"];
    const base=new Date();
    const offset=(base.getDay()+6)%7;
    for(let i=0;i<7;i++){
      const day=new Date(base); day.setDate(base.getDate()-offset+i);
      const key=dayKey(day);
      const played = S.history[key] && S.history[key].slots>0;
      const el=document.createElement("div");
      el.className="day"+(played?" hit":"")+(key===todayKey()?" today":"");
      el.innerHTML='<div class="dot">'+""+'</div><span>'+labels[i]+'</span>';
      wk.appendChild(el);
    }

    const top=board("today").slice(0,3);
    const wrap=$("topThree");
    wrap.className="podium";
    wrap.innerHTML="";
    [1,0,2].forEach(idx=>{
      const r=top[idx];
      if(!r) return;
      const place=idx+1;
      const el=document.createElement("div");
      el.className="pod p"+place+(r.me?" me":"");
      el.innerHTML='<div class="pod-name">'+(r.me?"Du":r.name)+'</div>'+
        '<div class="pod-score">'+r.score.toLocaleString("de-DE")+'</div>'+
        '<div class="pod-block">'+place+'</div>';
      wrap.appendChild(el);
    });
  }

  $("btnStart").addEventListener("click", ()=>{
    const t=today();
    if(t.done){ showTodayResult(); return; }
    const list = dailySet(todayKey()).slice(t.slots);
    runSequence({
      list, total:5, offset:t.slots,
      onEach:(res)=>{ t.slots+=1; t.score+=res.score; save(); },
      onDone:(sum, results)=>{
        t.done=true; t.score=sum; save();
        const perfect = results.every(r=>r.correct) && results.length>=5;
        if(perfect && !S.badges.includes("perfect")){ S.badges.push("perfect"); }
        const rw = grantRewards(sum);
        resultsDaily(sum, results, rw);
      }
    });
  });

  function showTodayResult(){
    const t=today();
    $("resVs").hidden=true;
    $("resBreakWrap").hidden=true;
    $("resLabel").textContent="Heute";
    $("resBig").textContent=t.score.toLocaleString("de-DE");
    $("resBig").classList.remove("win");
    $("resSub").textContent="Punkte";
    $("resCoins").textContent="✓";
    $("resXP").textContent="✓";
    show("results");
  }

  /* ---------- runner ---------- */
  let RUN=null, timerHandle=null, expireHandle=null;
  function clearTimers(){
    if(timerHandle){ clearTimeout(timerHandle); timerHandle=null; }
    if(expireHandle){ clearTimeout(expireHandle); expireHandle=null; }
  }

  function runSequence(opts){
    RUN = Object.assign({ i:0, results:[], sum:0 }, opts);
    show("play");
    const segs=$("segs"); segs.innerHTML="";
    for(let i=0;i<RUN.total;i++){
      const s=document.createElement("div"); s.className="seg"; s.innerHTML="<i></i>";
      if(i < (RUN.offset||0)) s.querySelector("i").style.width="100%";
      segs.appendChild(s);
    }
    next();
  }
  function next(){
    clearTimers();
    if(RUN.i >= RUN.list.length){ RUN.onDone(RUN.sum, RUN.results); return; }
    const cfg=RUN.list[RUN.i];
    const pos=(RUN.offset||0)+RUN.i;
    $("stageCount").textContent = (pos+1)+"/"+RUN.total;
    play(cfg, (res)=>{
      const seg=$("segs").children[pos];
      if(seg){ seg.classList.toggle("miss", !res.correct); seg.querySelector("i").style.width="100%"; }
      RUN.results.push(res); RUN.sum += res.score;
      if(RUN.onEach) RUN.onEach(res);
      toast(res.correct ? "+"+res.score : "Daneben", !res.correct);
      RUN.i++;
      setTimeout(next, 560);
    });
  }

  function startTimer(limit, onExpire){
    const bar=$("timer"), i=bar.querySelector("i");
    bar.classList.remove("hot");
    i.style.transition="none"; i.style.width="100%";
    requestAnimationFrame(()=>{ i.style.transition="width "+limit+"ms linear"; i.style.width="0%"; });
    timerHandle=setTimeout(()=> bar.classList.add("hot"), limit*.6);
    expireHandle=setTimeout(onExpire, limit);
  }

  function play(cfg, done){
    const body=$("stageBody");
    body.innerHTML="";
    $("stageKind").textContent = KIND_LABEL[cfg.type];
    $("stageTask").textContent = cfg.task;
    let finished=false;
    const t0=now();
    function finish(ok, ms){
      if(finished) return;
      finished=true; clearTimers();
      done({ correct:ok, ms, score:scoreOf(ok, ms, cfg.limit), type:cfg.type });
    }

    if(cfg.type==="memory"){
      const big=document.createElement("div");
      big.className="mega"; big.textContent=cfg.d.n;
      body.appendChild(big);
      startTimer(cfg.limit, ()=> finish(false, cfg.limit));
      setTimeout(()=>{
        if(finished) return;
        body.innerHTML="";
        const out=document.createElement("div"); out.className="mega small"; out.textContent="—";
        const hint=document.createElement("div"); hint.className="hint"; hint.textContent="Zahl eintippen";
        const pad=document.createElement("div"); pad.className="grid3";
        let typed="";
        for(let d=1; d<=9; d++) pad.appendChild(keyBtn(d));
        pad.appendChild(keyBtn("⌫"));
        pad.appendChild(keyBtn(0));
        const spacer=document.createElement("div");
        pad.appendChild(spacer);
        function keyBtn(v){
          const b=document.createElement("button");
          b.className="opt key"; b.textContent=v;
          b.addEventListener("click", ()=>{
            if(finished) return;
            if(v==="⌫"){ typed=typed.slice(0,-1); }
            else if(typed.length < cfg.d.n.length){ typed += v; }
            out.textContent = typed || "—";
            if(typed.length===cfg.d.n.length) finish(typed===cfg.d.n, now()-t0);
          });
          return b;
        }
        body.appendChild(hint); body.appendChild(out); body.appendChild(pad);
      }, cfg.d.flash);

    } else if(cfg.type==="reaction"){
      const zone=document.createElement("div");
      zone.className="tapzone wait";
      zone.innerHTML="<span>WARTE</span>";
      body.appendChild(zone);
      let goAt=0;
      const go=setTimeout(()=>{
        if(finished) return;
        zone.className="tapzone go"; zone.innerHTML="<span>JETZT!</span>"; goAt=now();
      }, cfg.d.delay);
      zone.addEventListener("click", ()=>{
        if(finished) return;
        if(!goAt){
          clearTimeout(go);
          zone.className="tapzone bust"; zone.innerHTML="<span>ZU FRÜH</span>";
          finish(false, cfg.limit);
        } else {
          finish(true, clamp(now()-goAt, 0, cfg.limit));
        }
      });
      expireHandle=setTimeout(()=>{ clearTimeout(go); finish(false, cfg.limit); }, cfg.d.delay+cfg.limit);

    } else if(cfg.type==="math"){
      const q=document.createElement("div"); q.className="mega"; q.textContent=cfg.d.q;
      body.appendChild(q);
      const grid=document.createElement("div"); grid.className="grid2";
      cfg.d.opts.forEach(o=>{
        const b=document.createElement("button"); b.className="opt"; b.textContent=o;
        b.addEventListener("click", ()=>{
          if(finished) return;
          const ok = o===cfg.d.ans;
          b.classList.add(ok?"right":"wrong");
          finish(ok, now()-t0);
        });
        grid.appendChild(b);
      });
      body.appendChild(grid);
      startTimer(cfg.limit, ()=> finish(false, cfg.limit));

    } else if(cfg.type==="color"){
      const w=document.createElement("div");
      w.className="mega small"; w.textContent=cfg.d.word; w.style.color=cfg.d.ink.h;
      body.appendChild(w);
      const grid=document.createElement("div"); grid.className="grid2";
      cfg.d.opts.forEach(o=>{
        const sw=document.createElement("div"); sw.className="swatch"; sw.style.background=o.h;
        sw.addEventListener("click", ()=>{
          if(finished) return;
          const ok = o.h===cfg.d.ink.h;
          sw.classList.add(ok?"right":"wrong");
          finish(ok, now()-t0);
        });
        grid.appendChild(sw);
      });
      body.appendChild(grid);
      startTimer(cfg.limit, ()=> finish(false, cfg.limit));

    } else if(cfg.type==="words"){
      const counter=document.createElement("div");
      counter.className="hint"; counter.textContent="0 / "+cfg.d.need;
      body.appendChild(counter);
      const wrap=document.createElement("div"); wrap.className="chips";
      let got=0;
      cfg.d.chips.forEach(word=>{
        const c=document.createElement("button"); c.className="wchip"; c.textContent=word;
        c.addEventListener("click", ()=>{
          if(finished || c.classList.contains("got") || c.classList.contains("bad")) return;
          if(cfg.d.good.includes(word)){
            c.classList.add("got"); got++;
            counter.textContent = got+" / "+cfg.d.need;
            if(got>=cfg.d.need) finish(true, now()-t0);
          } else {
            c.classList.add("bad");
          }
        });
        wrap.appendChild(c);
      });
      body.appendChild(wrap);
      startTimer(cfg.limit, ()=> finish(got>=cfg.d.need, cfg.limit));

    } else {
      const grid=document.createElement("div"); grid.className="tiles";
      cfg.d.before.forEach(c=>{
        const t=document.createElement("div"); t.className="tile"; t.style.background=c; grid.appendChild(t);
      });
      const hint=document.createElement("div"); hint.className="hint"; hint.textContent="Einprägen…";
      body.appendChild(grid); body.appendChild(hint);
      setTimeout(()=>{
        if(finished) return;
        grid.innerHTML="";
        for(let i=0;i<9;i++){ const t=document.createElement("div"); t.className="tile blank"; grid.appendChild(t); }
        hint.textContent="…";
        setTimeout(()=>{
          if(finished) return;
          grid.innerHTML=""; hint.textContent="Welches ist neu?";
          const t1=now();
          cfg.d.after.forEach((c,i)=>{
            const t=document.createElement("div"); t.className="tile"; t.style.background=c;
            t.addEventListener("click", ()=>{
              if(finished) return;
              const ok = i===cfg.d.idx;
              t.classList.add(ok?"right":"wrong");
              finish(ok, now()-t1);
            });
            grid.appendChild(t);
          });
          startTimer(cfg.limit, ()=> finish(false, cfg.limit));
        }, 700);
      }, cfg.d.flash);
    }
  }

  /* ---------- rewards ---------- */
  function addXP(n){
    S.profile.xp += n;
    let need = S.profile.level*100;
    while(S.profile.xp >= need){
      S.profile.xp -= need; S.profile.level++; need = S.profile.level*100;
      toast("Level "+S.profile.level+"!");
    }
  }
  function bumpStreak(){
    const k=todayKey();
    if(S.streak.last===k) return;
    const y=new Date(); y.setDate(y.getDate()-1);
    S.streak.count = (S.streak.last===dayKey(y)) ? S.streak.count+1 : 1;
    S.streak.last=k;
    if(S.streak.count > S.profile.longestStreak) S.profile.longestStreak=S.streak.count;
  }
  function grantRewards(score){
    const coins=Math.round(score/25), xp=Math.round(score/10);
    S.profile.coins += coins; addXP(xp); bumpStreak(); save();
    checkBadges(); renderHeader();
    return { coins, xp };
  }
  function checkBadges(){
    BADGES.forEach(b=>{
      if(S.badges.includes(b.id)) return;
      const hit =
        (b.id==="streak7" && S.streak.count>=7) ||
        (b.id==="streak30" && S.streak.count>=30) ||
        (b.id==="firstwin" && S.profile.wins>=1) ||
        (b.id==="tenwins" && S.profile.wins>=10);
      if(hit){ S.badges.push(b.id); popBadge(b); }
    });
    save();
  }
  function popBadge(b){
    $("bdgIc").textContent=b.ic; $("bdgTitle").textContent=b.name; $("bdgDesc").textContent=b.desc;
    $("badgeOverlay").hidden=false;
  }
