  function startMode(id){
    if(id==="speed"){
      runSequence({
        list: Array.from({length:10}, randomChallenge), total:10, offset:0,
        onEach:()=>{},
        onDone:(sum, results)=>{
          const mine = results.reduce((a,r)=>a+r.ms,0);
          const bot = mine*(0.85+Math.random()*0.3);
          const won = mine<=bot;
          const rw=grantRewards(sum);
          if(won) S.profile.wins++; else S.profile.losses++;
          save(); checkBadges(); renderHeader();
          $("resVs").hidden=true; $("resBreakWrap").hidden=false;
          $("resLabel").textContent="Speed Duel";
          $("resBig").textContent=(mine/1000).toFixed(1)+"s";
          $("resBig").classList.toggle("win", won);
          $("resSub").textContent = won ? "Schneller als der Bot ("+(bot/1000).toFixed(1)+"s)" : "Bot war schneller ("+(bot/1000).toFixed(1)+"s)";
          renderBreakdown(results);
          $("resCoins").textContent="+"+rw.coins; $("resXP").textContent="+"+rw.xp;
          show("results");
        }
      });
    } else if(id==="team"){
      const mate=pick(Math.random, FRIENDS);
      runSequence({
        list: Array.from({length:5}, randomChallenge), total:5, offset:0,
        onEach:()=>{},
        onDone:(sum, results)=>{
          const mateScore=Math.round(sum*(0.6+Math.random()*0.5));
          const team=sum+mateScore;
          const opp=Math.round(team*(0.75+Math.random()*0.5));
          const won=team>=opp;
          const rw=grantRewards(sum);
          if(won) S.profile.wins++; else S.profile.losses++;
          save(); checkBadges(); renderHeader();
          $("resVs").hidden=false; $("resBreakWrap").hidden=false;
          $("resLabel").textContent="Team Duel";
          $("resBig").textContent= won ? "TEAM WINS" : "TEAM LOSS";
          $("resBig").classList.toggle("win", won);
          $("resSub").textContent="mit "+mate.name+" · simuliert";
          $("resMyAva").textContent=S.profile.equipped.avatar;
          $("resMyScore").textContent=team;
          $("resOppAva").textContent="🤖";
          $("resOppName").textContent="GEGNER";
          $("resOppScore").textContent=opp;
          renderBreakdown(results);
          $("resCoins").textContent="+"+rw.coins; $("resXP").textContent="+"+rw.xp;
          show("results");
        }
      });
    } else {
      endurance(id);
    }
  }

  function endurance(mode){
    let cleared=0, lives = mode==="sudden"?1:3, sum=0;
    const results=[];
    show("play");
    $("segs").innerHTML="";
    function step(){
      $("stageCount").textContent = mode==="sudden" ? "Runde "+(cleared+1) : lives+" Leben";
      play(randomChallenge(), (r)=>{
        results.push(r);
        if(r.correct){
          cleared++; sum+=r.score;
          toast("+"+r.score);
          setTimeout(step, 480);
        } else {
          lives--;
          if(lives<=0){
            const rw=grantRewards(sum);
            if(mode==="sudden" && cleared>S.modeBest.sudden) S.modeBest.sudden=cleared;
            if(mode==="endless" && cleared>S.modeBest.endless) S.modeBest.endless=cleared;
            save(); renderHeader();
            $("resVs").hidden=true; $("resBreakWrap").hidden=false;
            $("resLabel").textContent = mode==="sudden"?"Sudden Death":"Endless";
            $("resBig").textContent=cleared;
            $("resBig").classList.add("win");
            $("resSub").textContent="Challenges geschafft · "+sum.toLocaleString("de-DE")+" Punkte";
            renderBreakdown(results.slice(-6));
            $("resCoins").textContent="+"+rw.coins; $("resXP").textContent="+"+rw.xp;
            show("results");
          } else {
            toast("Noch "+lives+" Leben", true);
            setTimeout(step, 620);
          }
        }
      });
    }
    step();
  }

