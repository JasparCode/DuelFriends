<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Daily Duel</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="./styles.css" />
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <div class="logo">Daily<em>Duel</em></div>
        <div class="pills">
          <div class="pill streak">
            <span class="lbl">Serie</span>
            <span class="num" id="hdrStreak">0</span>
          </div>
          <div class="pill coins" id="coinPill" aria-label="Coins öffnen">
            <span class="lbl">Coins</span>
            <span class="num" id="hdrCoins">0</span>
          </div>
        </div>
      </header>

      <main class="content" id="content">
        <section class="screen active" id="screen-home">
          <div class="hero">
            <span class="tag" id="dateTag">Heute</span>
            <h2 id="heroTitle">5 neue<br />Challenges</h2>
            <p id="heroSub">Alle spielen heute dieselben Aufgaben. Schnell sein bringt mehr Punkte.</p>
            <div class="slots" id="slots" aria-label="Fortschritt der heutigen Challenges"></div>
            <button class="btn btn-lime btn-block" id="btnStart">Duell starten</button>
          </div>

          <div class="eyebrow">Deine Serie</div>
          <div class="card">
            <div class="row between">
              <div>
                <div class="disp" style="font-size:30px; line-height:1.1;"><span id="streakNum">0</span> Tage</div>
                <div style="font-size:11.5px; color:var(--text-dim); font-weight:700; margin-top:2px;" id="streakHint">Heute spielen startet deine Serie</div>
              </div>
            </div>
            <div class="week" id="week"></div>
          </div>

          <div class="eyebrow">Top 3 weltweit</div>
          <div class="stack" id="topThree"></div>
        </section>

        <section class="screen" id="screen-duels" hidden>
          <div class="eyebrow">Freund herausfordern</div>
          <div class="stack" id="friends"></div>
          <div class="eyebrow">Letzte Duelle</div>
          <div class="stack" id="duelLog"></div>
        </section>

        <section class="screen" id="screen-modes" hidden>
          <div class="eyebrow">Spezial-Modi</div>
          <div class="stack" id="modes"></div>
        </section>

        <section class="screen" id="screen-board" hidden>
          <div class="eyebrow">Rangliste</div>
          <div class="tabs" id="boardTabs">
            <button class="tab active" data-scope="today">Heute</button>
            <button class="tab" data-scope="friends">Freunde</button>
            <button class="tab" data-scope="de">DE</button>
            <button class="tab" data-scope="world">Welt</button>
          </div>
          <div class="stack" id="board" style="margin-top:12px;"></div>
        </section>

        <section class="screen" id="screen-profile" hidden>
          <div class="card prof-head">
            <div class="lvl-wrap">
              <div class="lvl-ring" id="lvlRing"></div>
              <div class="lvl-inner" id="profAva">🙂</div>
              <div class="lvl-badge" id="lvlBadge">LVL 1</div>
            </div>
            <input id="profName" maxlength="14" aria-label="Benutzername" />
            <div style="font-size:11.5px; color:var(--text-dim); font-weight:800; letter-spacing:.06em; text-transform:uppercase;" id="profTitle">Neuling</div>
            <div class="stats">
              <div class="stat"><div class="v" id="stWins">0</div><div class="k">Siege</div></div>
              <div class="stat"><div class="v" id="stLoss">0</div><div class="k">Nied.</div></div>
              <div class="stat"><div class="v" id="stStreak">0</div><div class="k">Rekord</div></div>
              <div class="stat"><div class="v" id="stXP">0</div><div class="k">XP</div></div>
            </div>
          </div>

          <div class="eyebrow">Abzeichen</div>
          <div class="badges" id="badges"></div>

          <div class="eyebrow">Shop</div>
          <button class="btn btn-hot btn-block" id="btnShop">Shop öffnen</button>
        </section>

        <section class="screen" id="screen-shop" hidden>
          <div class="row between" style="margin:6px 0 10px;">
            <h2 style="font-size:22px;">Shop</h2>
            <div class="pill coins">🪙<span class="num" id="shopCoins">0</span></div>
          </div>
          <div class="tabs" id="shopTabs">
            <button class="tab active" data-cat="avatar">Avatare</button>
            <button class="tab" data-cat="background">Design</button>
            <button class="tab" data-cat="title">Titel</button>
            <button class="tab" data-cat="effect">Effekte</button>
          </div>
          <div class="shop-grid" id="shopGrid" style="margin-top:12px;"></div>
        </section>

        <section class="screen" id="screen-play" hidden>
          <div class="stage">
            <div class="stage-head">
              <div class="segs" id="segs"></div>
              <div class="stage-meta">
                <div class="stage-kind" id="stageKind">Memory</div>
                <div class="stage-count" id="stageCount">1/5</div>
              </div>
              <p class="stage-task" id="stageTask">Merk dir die Zahl.</p>
              <div class="timer" id="timer"><i></i></div>
            </div>
            <div class="stage-body" id="stageBody"></div>
          </div>
        </section>

        <section class="screen" id="screen-results" hidden>
          <div class="result-top">
            <div class="result-label" id="resLabel">Ergebnis</div>
            <div class="result-big" id="resBig">0</div>
            <div class="result-sub" id="resSub">Punkte</div>
          </div>

          <div class="card" id="resVs" hidden style="margin-top:6px;">
            <div class="vs">
              <div class="vs-side">
                <div class="ava lg" style="margin:0 auto;" id="resMyAva">🙂</div>
                <div class="sc" id="resMyScore">0</div>
                <div style="font-size:11px; color:var(--text-dim); font-weight:800;">DU</div>
              </div>
              <div class="vs-mid">VS</div>
              <div class="vs-side">
                <div class="ava lg" style="margin:0 auto;" id="resOppAva">🦊</div>
                <div class="sc" id="resOppScore">0</div>
                <div style="font-size:11px; color:var(--text-dim); font-weight:800;" id="resOppName">GEGNER</div>
              </div>
            </div>
          </div>

          <div id="resBreakWrap">
            <div class="eyebrow">Deine Runde</div>
            <div class="card breakdown" id="resBreak"></div>
          </div>

          <div class="eyebrow">Belohnung</div>
          <div class="reward-row">
            <div class="reward-box"><div class="v" style="color:var(--gold);" id="resCoins">+0</div><div class="k">Coins</div></div>
            <div class="reward-box"><div class="v" style="color:var(--gold);" id="resXP">+0</div><div class="k">XP</div></div>
          </div>

          <button class="btn btn-lime btn-block" id="btnResDone" style="margin-top:16px;">Weiter</button>
        </section>
      </main>

      <nav class="nav" aria-label="Hauptnavigation">
        <button class="navbtn active" data-screen="home">Home</button>
        <button class="navbtn" data-screen="duels">Duelle</button>
        <button class="navbtn" data-screen="modes">Modi</button>
        <button class="navbtn" data-screen="board">Rang</button>
        <button class="navbtn" data-screen="profile">Profil</button>
      </nav>

      <div class="overlay" id="rewardOverlay" hidden>
        <div class="modal">
          <h3>Tagesbelohnung</h3>
          <div class="amount" id="rewardAmount">+50</div>
          <p id="rewardStreak">Coins für heute</p>
          <button class="btn btn-lime btn-block" id="btnRewardClose" style="margin-top:14px;">Einsammeln</button>
        </div>
      </div>

      <div class="overlay" id="badgeOverlay" hidden>
        <div class="modal">
          <span class="big-ic" id="bdgIc">🏅</span>
          <h3 id="bdgTitle">Neues Abzeichen</h3>
          <p id="bdgDesc"></p>
          <button class="btn btn-hot btn-block" id="btnBdgClose" style="margin-top:14px;">Stark</button>
        </div>
      </div>

      <div class="toast" id="toast"></div>
    </div>

    <script src="./app.js"></script>
  </body>
</html>
