      const rows=FRIENDS.map(f=>({
        name:f.name, ava:f.ava,
        score: dailySet(key).reduce((a,_,i)=> a+botScore(f.id,key,i,f.skill), 0), me:false
      }));
      rows.push({ name:S.profile.username, ava:S.profile.equipped.avatar, score:mine, me:true });
      return rows.sort((a,b)=>b.score-a.score);
    }
    const rng=rngOf("lb:"+sc+":"+key);
    const n = sc==="today"?24 : sc==="de"?40 : 60;
    const rows=[];
    for(let i=0;i<n;i++){
      const s = sc==="world" ? rInt(rng,6000,9900) : sc==="de" ? rInt(rng,4000,8800) : rInt(rng,500,4200);
      rows.push({ name:pick(rng,NAMES)+rInt(rng,1,99), ava:"", score:s, me:false });
    }
    rows.push({ name:S.profile.username, ava:S.profile.equipped.avatar, score:mine, me:true });
    return rows.sort((a,b)=>b.score-a.score);
  }
