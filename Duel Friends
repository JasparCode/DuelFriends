<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
  :root{ color-scheme: light; padding-top: env(safe-area-inset-top, 0px); padding-bottom: env(safe-area-inset-bottom, 0px); }
  html,body{ margin:0; }
  img{ max-width:100%; }
  [hidden]{ display:none !important; }
</style>
<title>Daily Duel</title>

<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

</head>
<style>
  /* ============ TOKENS ============ */
  :root{
    --bg:#FAF9F6; --surface:#FFFFFF; --surface-2:#F3F0E9; --line:#E7E2D7; --line-soft:#EFEBE2;
    --text:#171614; --text-dim:#7A756A;
    --accent:#171614; --accent-ink:#FAF9F6;
    --gold:#9C7C3C; --gold-soft:#C9A96A;
    --good:#2E7D5B; --bad:#A8443B;
    --ring:rgba(23,22,20,.09);
    color-scheme: light;
  }
  @media (prefers-color-scheme: dark){
    :root:not([data-theme="light"]){
      --bg:#0F0E0C; --surface:#171613; --surface-2:#211F1A; --line:#2E2B25; --line-soft:#241F1A;
      --text:#F3F0E9; --text-dim:#948E81;
      --accent:#C9A96A; --accent-ink:#14130F;
      --gold:#C9A96A; --gold-soft:#E0CDA4;
      --good:#4FBF8B; --bad:#D9736A;
      --ring:rgba(243,240,233,.1);
      color-scheme: dark;
    }
  }
  :root[data-theme="dark"]{
    --bg:#0F0E0C; --surface:#171613; --surface-2:#211F1A; --line:#2E2B25; --line-soft:#241F1A;
    --text:#F3F0E9; --text-dim:#948E81;
    --accent:#C9A96A; --accent-ink:#14130F;
    --gold:#C9A96A; --gold-soft:#E0CDA4;
    --good:#4FBF8B; --bad:#D9736A;
    --ring:rgba(243,240,233,.1);
    color-scheme: dark;
  }

  html,body{ height:100%; }
  body{
    margin:0; background:var(--bg); color:var(--text);
    font-family:'Instrument Sans', ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    font-weight:400; font-size:14px; line-height:1.55;
    font-variant-numeric: tabular-nums;
    display:flex; justify-content:center;
    -webkit-user-select:none; -moz-user-select:none; user-select:none;
    -webkit-tap-highlight-color:transparent; -webkit-touch-callout:none;
  }
  *{ box-sizing:border-box; }
  input, textarea{ -webkit-user-select:text; user-select:text; }
  ::selection{ background:transparent; }
  input::selection{ background:var(--surface-2); }

  h1,h2,h3{ margin:0; font-weight:400; letter-spacing:-.01em; text-wrap:balance; }
  .serif, .disp, .hero h2, .mega, .result-big, .stage-kind, .modal h3, .modal .amount,
  .vs-side .sc, .stat .v, .lvl-badge, .result-top .result-big{
    font-family:'Instrument Serif', Georgia, 'Times New Roman', serif;
    font-weight:400; letter-spacing:-.01em;
  }
  button{ font-family:inherit; color:inherit; }
  button:focus-visible, input:focus-visible{ outline:1.5px solid var(--gold); outline-offset:3px; }
  @media (prefers-reduced-motion: reduce){ *{ animation-duration:.001ms !important; transition-duration:.001ms !important; } }

  .app{ width:100%; max-width:420px; min-height:100%; display:flex; flex-direction:column; background:var(--bg); }

  /* ============ TOP BAR ============ */
  .topbar{
    position:sticky; top:env(safe-area-inset-top,0px); z-index:30;
    display:flex; align-items:center; justify-content:space-between;
    padding:18px 22px 14px; background:var(--bg);
  }
  .logo{ font-size:11.5px; font-weight:600; letter-spacing:.18em; text-transform:uppercase; }
  .logo em{ font-style:normal; color:var(--gold); }
  .pills{ display:flex; gap:18px; align-items:baseline; }
  .pill{ display:flex; align-items:baseline; gap:6px; font-size:12px; }
  .pill .lbl{ font-size:9.5px; letter-spacing:.14em; text-transform:uppercase; color:var(--text-dim); }
  .pill .num{ font-size:13px; font-weight:600; color:var(--text); }
  .pill.coins{ cursor:pointer; }
  .pill.coins .num{ color:var(--gold); }

  /* ============ CONTENT ============ */
  .content{ flex:1; overflow-y:auto; padding:8px 22px calc(110px + env(safe-area-inset-bottom,0px)); }
  .content.stage-mode{ padding:0; display:flex; flex-direction:column; }
  .content.stage-mode > .screen{ flex:1; display:flex; flex-direction:column; }
  .screen[hidden]{ display:none !important; }

  .eyebrow{
    display:flex; align-items:center; gap:12px;
    font-size:10px; font-weight:600; letter-spacing:.18em; text-transform:uppercase;
    color:var(--text-dim); margin:34px 0 14px;
  }
  .eyebrow::after{ content:""; flex:1; height:1px; background:var(--line); }
  .eyebrow:first-child{ margin-top:12px; }

  .card{ background:var(--surface); border:1px solid var(--line); border-radius:14px; padding:20px; }
  .stack{ display:flex; flex-direction:column; }
  .row{ display:flex; align-items:center; gap:12px; }
  .row.between{ justify-content:space-between; }

  /* ============ BUTTONS ============ */
  .btn{
    border:1px solid transparent; border-radius:12px; padding:15px 20px;
    font-size:12px; font-weight:600; letter-spacing:.12em; text-transform:uppercase; cursor:pointer;
    display:inline-flex; align-items:center; justify-content:center; gap:8px;
    transition:opacity .15s ease;
  }
  .btn-lime, .btn-hot{ background:var(--accent); color:var(--accent-ink); }
  .btn-ghost{ background:transparent; color:var(--text); border-color:var(--line); }
  .btn:active{ opacity:.72; }
  .btn-block{ width:100%; }
  .btn-sm{ padding:9px 15px; font-size:10px; letter-spacing:.14em; }
  .btn[disabled]{ opacity:.32; cursor:not-allowed; }

  /* ============ HERO ============ */
  .hero{ padding:16px 0 6px; }
  .hero .tag{ font-size:10px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--gold); }
  .hero h2{ font-size:38px; line-height:1.08; margin:14px 0 10px; }
  .hero p{ margin:0 0 26px; font-size:13.5px; color:var(--text-dim); max-width:32ch; line-height:1.6; }

  .slots{ display:flex; gap:1px; margin-bottom:26px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .slot{
    flex:1; height:46px; display:flex; align-items:center; justify-content:center;
    background:var(--bg); font-size:12px; color:var(--text-dim); letter-spacing:.06em;
  }
  .slot.done{ background:var(--accent); color:var(--accent-ink); }

  /* ============ STREAK WEEK ============ */
  .week{ display:flex; gap:5px; margin-top:20px; }
  .day{ flex:1; text-align:center; }
  .day .dot{ height:26px; border:1px solid var(--line); background:transparent; margin-bottom:6px; border-radius:10px; }
  .day.hit .dot{ background:var(--gold); border-color:var(--gold); }
  .day.today .dot{ border-color:var(--text); }
  .day span{ font-size:9.5px; color:var(--text-dim); letter-spacing:.08em; }

  /* ============ LIST ITEMS ============ */
  .item{ display:flex; align-items:center; gap:14px; padding:15px 0; border-bottom:1px solid var(--line); }
  .item:last-child{ border-bottom:none; }
  .ava{
    width:36px; height:36px; border-radius:10px; display:flex; align-items:center; justify-content:center;
    font-size:17px; background:var(--surface-2); flex-shrink:0;
  }
  .ava.lg{ width:58px; height:58px; font-size:26px; }
  .item .meta{ flex:1; min-width:0; }
  .item .nm{ font-weight:500; font-size:14px; }
  .item .sb{ font-size:11.5px; color:var(--text-dim); margin-top:2px; letter-spacing:.02em; }
  .rank{ width:24px; font-size:12px; color:var(--text-dim); flex-shrink:0; letter-spacing:.04em; }
  .rank.top{ color:var(--gold); font-weight:600; }
  .item.me .nm{ font-weight:700; }
  .score-val{ font-size:14px; font-weight:600; letter-spacing:-.01em; }

  .chip{ border-radius:999px; font-size:9.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; padding:4px 10px; border:1px solid var(--line); color:var(--text-dim); }
  .chip.win{ color:var(--gold); border-color:color-mix(in srgb, var(--gold) 45%, var(--line)); }

  /* ============ TABS ============ */
  .tabs{ display:flex; gap:26px; border-bottom:1px solid var(--line); }
  .tab{
    padding:0 0 12px; font-size:11px; font-weight:600; letter-spacing:.12em; text-transform:uppercase;
    color:var(--text-dim); background:none; border:none; border-bottom:1px solid transparent;
    cursor:pointer; margin-bottom:-1px;
  }
  .tab.active{ color:var(--text); border-bottom-color:var(--gold); }

  /* ============ NAV ============ */
  .nav{
    position:fixed; bottom:calc(16px + env(safe-area-inset-bottom,0px)); left:50%; transform:translateX(-50%);
    width:calc(100% - 36px); max-width:384px; z-index:40; display:flex; gap:4px;
    padding:6px; background:var(--surface);
    border:1px solid var(--line); border-radius:20px;
    box-shadow:0 8px 28px -14px rgba(23,22,20,.35);
  }
  .navbtn{
    flex:1; background:none; border:none; cursor:pointer; padding:12px 2px;
    border-radius:15px;
    font-size:10.5px; font-weight:600; letter-spacing:.06em; text-transform:uppercase; color:var(--text-dim);
    transition:opacity .12s ease;
  }
  .navbtn:active{ opacity:.65; }
  .navbtn .ic{ display:none; }
  .navbtn.active{ background:var(--accent); color:var(--accent-ink); }

  /* ============ STAGE (play) ============ */
  .stage{
    background:var(--bg); color:var(--text); flex:1; min-height:100%;
    display:flex; flex-direction:column;
    padding:calc(20px + env(safe-area-inset-top,0px)) 22px calc(28px + env(safe-area-inset-bottom,0px));
  }
  .stage-head{ flex-shrink:0; }
  .segs{ display:flex; gap:4px; margin-bottom:24px; }
  .seg{ flex:1; height:2px; border-radius:2px; background:var(--line); overflow:hidden; }
  .seg > i{ display:block; height:100%; width:0; background:var(--gold); transition:width .3s ease; }
  .seg.miss > i{ background:var(--line); }

  .stage-meta{ display:flex; justify-content:space-between; align-items:baseline; }
  .stage-kind{ font-size:26px; }
  .stage-count{ font-size:10.5px; color:var(--text-dim); letter-spacing:.16em; text-transform:uppercase; }
  .stage-task{ font-size:13px; color:var(--text-dim); margin:6px 0 18px; }

  .timer{ height:3px; border-radius:3px; background:var(--line); overflow:hidden; }
  .timer > i{ display:block; height:100%; width:100%; background:var(--gold); border-radius:3px; }
  .timer.hot > i{ background:var(--bad); }

  .stage-body{
    flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:26px; text-align:center; padding:22px 0;
  }
  .mega{ font-size:72px; line-height:1; }
  .mega.small{ font-size:52px; }
  .hint{ font-size:10.5px; color:var(--text-dim); letter-spacing:.16em; text-transform:uppercase; }

  .tapzone{
    width:100%; max-width:250px; aspect-ratio:1; border-radius:10px; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-size:11px; font-weight:600; letter-spacing:.2em; text-transform:uppercase;
  }
  .tapzone.wait{ background:transparent; color:var(--text-dim); border:1px solid var(--line); }
  .tapzone.go{ background:var(--accent); color:var(--accent-ink); }
  .tapzone.bust{ background:transparent; border:1px solid var(--bad); color:var(--bad); }

  .grid2{ display:grid; grid-template-columns:1fr 1fr; gap:10px; width:100%; }
  .grid3{ display:grid; grid-template-columns:repeat(3,1fr); gap:8px; width:100%; }
  .opt{
    padding:19px 10px; border-radius:10px; cursor:pointer;
    background:transparent; border:1px solid var(--line); color:var(--text);
    font-family:'Instrument Serif', Georgia, serif; font-size:22px; transition:opacity .12s ease;
  }
  .opt:active{ opacity:.6; }
  .opt.right{ background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
  .opt.wrong{ border-color:var(--bad); color:var(--bad); }
  .key{ padding:15px 6px; font-size:20px; }

  .swatch{ height:72px; border-radius:10px; cursor:pointer; border:1px solid var(--line); }
  .swatch.right{ outline:1px solid var(--gold); outline-offset:3px; }
  .swatch.wrong{ opacity:.3; }

  .chips{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }
  .wchip{
    padding:11px 16px; border-radius:10px; cursor:pointer; font-size:13.5px;
    background:transparent; border:1px solid var(--line); color:var(--text);
  }
  .wchip.got{ background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
  .wchip.bad{ opacity:.28; }

  .tiles{ display:grid; grid-template-columns:repeat(3,1fr); gap:6px; width:100%; max-width:236px; }
  .tile{ aspect-ratio:1; border-radius:10px; cursor:pointer; border:1px solid transparent; }
  .tile.right{ outline:1px solid var(--gold); outline-offset:3px; }
  .tile.wrong{ opacity:.3; }
  .tile.blank{ background:var(--surface-2) !important; }

  /* ============ RESULTS ============ */
  .result-top{ text-align:center; padding:44px 4px 14px; }
  .result-label{ font-size:10px; font-weight:600; letter-spacing:.2em; text-transform:uppercase; color:var(--gold); }
  .result-big{ font-size:64px; line-height:1.05; margin:14px 0 6px; }
  .result-big.win{ color:var(--gold); }
  .result-sub{ font-size:12.5px; color:var(--text-dim); }

  .vs{ display:flex; align-items:center; gap:12px; }
  .vs-side{ flex:1; text-align:center; }
  .vs-side .sc{ font-size:30px; margin-top:10px; }
  .vs-mid{ font-size:9.5px; color:var(--text-dim); letter-spacing:.2em; text-transform:uppercase; }

  .breakdown{ display:flex; flex-direction:column; padding:2px 20px; }
  .brow{ display:flex; align-items:center; gap:14px; padding:13px 0; border-bottom:1px solid var(--line); }
  .brow:last-child{ border-bottom:none; }
  .brow .idx{ font-size:11px; color:var(--text-dim); width:14px; }
  .brow .knd{ flex:1; font-size:13.5px; }
  .brow .tm{ font-size:11.5px; color:var(--text-dim); }
  .brow .pts{ font-size:13.5px; font-weight:600; width:50px; text-align:right; }
  .brow.ok .pts{ color:var(--text); }
  .brow.no .pts{ color:var(--text-dim); }

  .reward-row{ display:flex; gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .reward-box{ flex:1; background:var(--bg); padding:20px 10px; text-align:center; }
  .reward-box .v{ font-family:'Instrument Serif',Georgia,serif; font-size:26px; }
  .reward-box .k{ font-size:9.5px; color:var(--text-dim); margin-top:4px; letter-spacing:.16em; text-transform:uppercase; }

  /* ============ PROFILE ============ */
  .prof-head{ text-align:center; padding:10px 0 6px; }
  .lvl-wrap{ position:relative; width:88px; height:88px; margin:0 auto 18px; }
  .lvl-ring{ position:absolute; inset:0; border-radius:50%; }
  .lvl-inner{
    position:absolute; inset:3px; border-radius:50%; background:var(--bg);
    display:flex; align-items:center; justify-content:center; font-size:30px; border:1px solid var(--line);
  }
  .lvl-badge{
    position:absolute; bottom:-8px; left:50%; transform:translateX(-50%);
    background:var(--bg); color:var(--gold); font-size:12px;
    padding:1px 10px; border:1px solid var(--line); border-radius:999px; white-space:nowrap;
  }
  #profName{
    text-align:center; font-family:'Instrument Serif',Georgia,serif; font-size:24px;
    border:none; background:transparent; color:var(--text); width:100%; padding:4px 0;
  }
  #profTitle{ color:var(--gold) !important; }
  .stats{ display:grid; grid-template-columns:repeat(4,1fr); margin-top:22px; border-top:1px solid var(--line); padding-top:18px; }
  .stat{ text-align:center; }
  .stat .v{ font-size:22px; }
  .stat .k{ font-size:9.5px; color:var(--text-dim); margin-top:3px; letter-spacing:.12em; text-transform:uppercase; }

  .badges{ display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .bdg{ background:var(--bg); padding:18px 12px; text-align:center; }
  .bdg .ic{ font-size:20px; display:block; margin-bottom:8px; }
  .bdg .nm{ font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--text-dim); }
  .bdg.locked{ opacity:.3; }

  /* ============ SHOP ============ */
  .shop-grid{ display:grid; grid-template-columns:1fr 1fr; gap:1px; background:var(--line); border:1px solid var(--line); border-radius:12px; overflow:hidden; }
  .sitem{ background:var(--bg); padding:20px 14px; text-align:center; }
  .sitem.on{ background:var(--surface-2); }
  .sitem .pv{ font-size:26px; margin-bottom:10px; }
  .sitem .nm{ font-size:12.5px; }
  .sitem .pr{ font-size:10.5px; color:var(--gold); margin:6px 0 12px; letter-spacing:.1em; text-transform:uppercase; }

  /* ============ MODES ============ */
  .mode{ display:flex; align-items:center; gap:16px; padding:18px 0; cursor:pointer; border-bottom:1px solid var(--line); }
  .mode:last-child{ border-bottom:none; }
  .mode .mi{ width:32px; height:32px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:15px; flex-shrink:0; background:transparent !important; border:1px solid var(--line); color:var(--text) !important; }
  .mode .mt{ flex:1; }
  .mode .mt .nm{ font-size:14px; font-weight:600; letter-spacing:.02em; }
  .mode .mt .ds{ font-size:12px; color:var(--text-dim); margin-top:3px; }
  .mode .best{ font-size:10px; color:var(--gold); margin-top:4px; letter-spacing:.12em; text-transform:uppercase; }

  /* ============ OVERLAY ============ */
  .overlay{ position:fixed; inset:0; background:rgba(15,14,12,.55); z-index:90; display:flex; align-items:center; justify-content:center; padding:24px; }
  .overlay[hidden]{ display:none !important; }
  .modal{ background:var(--bg); border:1px solid var(--line); border-radius:12px; padding:34px 26px 26px; max-width:320px; width:100%; text-align:center; }
  .modal .big-ic{ font-size:22px; display:block; margin-bottom:14px; }
  .modal h3{ font-size:24px; margin-bottom:10px; }
  .modal p{ font-size:12px; color:var(--text-dim); margin:0; letter-spacing:.04em; }
  .modal .amount{ font-size:46px; color:var(--gold); margin:10px 0 6px; }

  .toast{
    position:fixed; top:calc(72px + env(safe-area-inset-top,0px)); left:50%; transform:translateX(-50%) translateY(-4px);
    background:var(--accent); color:var(--accent-ink); padding:9px 18px; border-radius:10px;
    font-size:10.5px; font-weight:600; letter-spacing:.14em; text-transform:uppercase;
    z-index:95; opacity:0; pointer-events:none; transition:opacity .15s ease, transform .15s ease;
  }
  .toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }
  .toast.miss{ background:transparent; color:var(--text-dim); border:1px solid var(--line); }


  /* ============ PODEST ============ */
  .podium{
    display:grid; grid-template-columns:1fr 1.18fr 1fr; gap:8px; align-items:end;
    border-bottom:1px solid var(--line); padding-top:6px;
  }
  .pod{ text-align:center; min-width:0; }
  .pod-name{ font-size:12.5px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .pod-score{ font-family:'Instrument Serif',Georgia,serif; font-size:17px; color:var(--text-dim); margin:2px 0 10px; }
  .pod-block{
    display:flex; align-items:center; justify-content:center;
    border:1px solid var(--line); border-bottom:none; border-radius:12px 12px 0 0;
    font-family:'Instrument Serif',Georgia,serif; font-size:24px; color:var(--text-dim);
  }
  .pod.p1 .pod-name{ font-size:13.5px; }
  .pod.p1 .pod-score{ color:var(--gold); font-size:22px; }
  .pod.p1 .pod-block{ height:98px; background:var(--accent); color:var(--accent-ink); border-color:var(--accent); font-size:30px; }
  .pod.p2 .pod-block{ height:74px; }
  .pod.p3 .pod-block{ height:58px; }
  .pod.me .pod-name{ font-weight:700; }

  .empty{ font-size:12px; color:var(--text-dim); text-align:center; padding:30px 12px; letter-spacing:.04em; }
</style>

<body>
<div class="app">

  <div class="topbar">
    <div class="logo">Daily<em>Duel</em></div>
    <div class="pills">
      <div class="pill streak"><span class="lbl">Serie</span><span class="num" id="hdrStreak">0</span></div>
      <div class="pill coins" id="coinPill"><span class="lbl">Coins</span><span class="num" id="hdrCoins">0</span></div>
    </div>
  </div>

  <div class="content" id="content">

    <!-- HOME -->
    <section class="screen" id="screen-home">
      <div class="hero">
        <span class="tag" id="dateTag">Heute</span>
        <h2 id="heroTitle">5 neue<br>Challenges</h2>
        <p id="heroSub">Alle spielen heute dieselben Aufgaben. Schnell sein bringt mehr Punkte.</p>
        <div class="slots" id="slots"></div>
        <button class="btn btn-lime btn-block" id="btnStart">Duell starten</button>
      </div>

      <div class="eyebrow">Deine Serie</div>
      <div class="card">
        <div class="row between">
          <div>
            <div class="disp" style="font-size:30px; line-height:1.1;"><span id="streakNum">0</span> Tage</div>
