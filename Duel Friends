  /* ---------- boot ---------- */
  function boot(){
    renderHeader(); renderHome(); renderDuels(); renderModes(); renderBoard(); renderProfile(); renderShop();
    show("home");
    setTimeout(dailyReward, 400);
  }
  const hot = window.claude && window.claude.hot;
  if(hot && hot.data && hot.data.S){ try{ Object.assign(S, hot.data.S); }catch(e){} }
  if(hot && typeof hot.snapshot==="function"){ hot.snapshot(()=>({ S })); }
  if(hot && hot.ready){ hot.ready(boot); } else { boot(); }
})();
