  function startDuel(fid){
    const f=FRIENDS.find(x=>x.id===fid);
    const key=todayKey();
    runSequence({
      list: dailySet(key), total:5, offset:0,
      onEach:()=>{},
      onDone:(sum, results)=>{
        const opp = results.reduce((a,_,i)=> a + botScore(f.id, key, i, f.skill), 0);
        const won = sum >= opp;
        const rw = grantRewards(sum);
        if(won){ S.profile.wins++; S.profile.coins += 40; } else { S.profile.losses++; }
        S.duels.push({ name:f.name, ava:f.ava, my:sum, opp, won });
